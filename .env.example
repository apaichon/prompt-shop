# Local development only. Never commit .env or use these credentials in GCP.
POSTGRES_USER=prompt_shop_operator
POSTGRES_PASSWORD=local-prototype-only
POSTGRES_DB=prompt_shop
POSTGRES_PORT=55432
OPERATOR_DATABASE_URL=postgres://prompt_shop_operator:local-prototype-only@127.0.0.1:55432/prompt_shop?sslmode=disable
# Bootstrap the read-only login with migrations/local_roles.sql before serving.
DATABASE_URL=postgres://prompt_shop_reader:local-reader-only@127.0.0.1:55432/prompt_shop?sslmode=disable
READINESS_MODE=foundation
PORT=8080

# Enable only after the private ADK service is running.
VOICE_ENABLED=false
# Match agent/.env. embedding skips the Laya readiness check. Empty keeps that check.
INTENT_BACKEND=embedding
TICKET_DATABASE_URL=postgres://prompt_shop_ticket:local-ticket-only@127.0.0.1:55432/prompt_shop?sslmode=disable
ADK_BRIDGE_SECRET=
# Explicit localhost-only HTTP development; prohibited on Cloud Run.
VOICE_ALLOW_LOCAL_HTTP=false

# Optional backoffice. Set all three together (hash is not needed with shared auth); never use operator credentials here.
# Provision a LOGIN with prompt_shop_backoffice membership through an operator.
BACKOFFICE_DATABASE_URL=
PUBLIC_ORIGIN=
# bcrypt cost 12; quote the value in shell env files to preserve dollar signs.
ADMIN_PASSWORD_HASH=
# Build the portal before setting this path.
STATIC_DIR=web/build

# Local MVP startup enables a ten-account login and writes owner-only files in tmp/auth.
# For other launchers, enable explicitly and point to a server-only bcrypt account file.
SHOPPER_AUTH_ENABLED=
SHOPPER_ACCOUNTS_FILE=
