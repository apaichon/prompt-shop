# Local development only. Never commit .env or use these credentials in GCP.
POSTGRES_USER=prompt_shop_operator
POSTGRES_PASSWORD=local-prototype-only
POSTGRES_DB=prompt_shop
POSTGRES_PORT=55432
OPERATOR_DATABASE_URL=postgres://prompt_shop_operator:local-prototype-only@127.0.0.1:55432/prompt_shop?sslmode=disable
# Bootstrap the read-only login with migrations/local_roles.sql before serving.
DATABASE_URL=postgres://prompt_shop_reader:local-reader-only@127.0.0.1:55432/prompt_shop?sslmode=disable
READINESS_MODE=foundation
PORT=8080

# Optional backoffice. Set all three together; never use operator credentials here.
# Provision a LOGIN with prompt_shop_backoffice membership through an operator.
BACKOFFICE_DATABASE_URL=
PUBLIC_ORIGIN=
# bcrypt cost 12; quote the value in shell env files to preserve dollar signs.
ADMIN_PASSWORD_HASH=
# Build the portal before setting this path.
STATIC_DIR=web/build
