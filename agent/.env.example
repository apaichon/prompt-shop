GOOGLE_API_KEY=
# Model ID accepted by your Gemini Developer API account. Restart ADK after edits.
GEMINI_MODEL=gemini-3.8-live
# Prebuilt voice name, e.g. Aoede or Kore. Empty uses the provider default.
GEMINI_VOICE=
# Use the same random value in Go gateway and this private runtime.
ADK_BRIDGE_SECRET=
