{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "store_id": {
      "const": "demo-store"
    },
    "import_version": {
      "type": "string",
      "pattern": "^[a-z0-9-]{1,64}$"
    },
    "store": {
      "$ref": "#/$defs/store"
    },
    "aisles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/aisle"
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      }
    },
    "shelves": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/shelf"
      }
    },
    "products": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/product"
      },
      "maxItems": 10000
    }
  },
  "required": [
    "schema_version",
    "store_id",
    "import_version",
    "products"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prompt-shop.example/schemas/import-v1.json",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]{1,64}$"
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0
        },
        "y": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "x",
        "y"
      ]
    },
    "store": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "map_width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "map_height": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "entrance_node_id": {
          "const": "entrance"
        }
      },
      "required": [
        "name",
        "map_width",
        "map_height",
        "entrance_node_id"
      ]
    },
    "alias": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "language": {
          "enum": [
            "en-US",
            "th-TH",
            "zh-CN",
            "ja-JP"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      },
      "required": [
        "language",
        "text"
      ]
    },
    "aisle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]{1,64}$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "polygon": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/point"
          },
          "minItems": 3,
          "maxItems": 64
        }
      },
      "required": [
        "id",
        "label",
        "polygon"
      ]
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]{1,64}$"
        },
        "x": {
          "type": "number",
          "minimum": 0
        },
        "y": {
          "type": "number",
          "minimum": 0
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      },
      "required": [
        "id",
        "x",
        "y",
        "label"
      ]
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "from_node_id": {
          "type": "string",
          "pattern": "^[a-z0-9-]{1,64}$"
        },
        "to_node_id": {
          "type": "string",
          "pattern": "^[a-z0-9-]{1,64}$"
        },
        "weight": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "from_node_id",
        "to_node_id",
        "weight"
      ]
    },
    "shelf": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]{1,64}$"
        },
        "aisle_id": {
          "type": "string",
          "pattern": "^[a-z0-9-]{1,64}$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "map_node_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z0-9-]{1,64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "x": {
          "type": "number",
          "minimum": 0
        },
        "y": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "id",
        "aisle_id",
        "label",
        "map_node_id",
        "x",
        "y"
      ]
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]{1,64}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "shelf_id": {
          "type": "string",
          "pattern": "^[a-z0-9-]{1,64}$"
        },
        "state": {
          "enum": [
            "draft",
            "published",
            "archived"
          ]
        },
        "aliases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/alias"
          },
          "minItems": 1,
          "maxItems": 20
        }
      },
      "required": [
        "id",
        "name",
        "category",
        "shelf_id",
        "state",
        "aliases"
      ]
    }
  }
}
